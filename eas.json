{
  "cli": {
    "version": ">= 20.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "24.19.0"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "24.19.0",
      "env": {
        "EXPO_PUBLIC_IAP_FUNCTIONS_BASE_URL": "https://us-central1-advent-calendar-12.cloudfunctions.net"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "24.19.0",
      "env": {
        "EXPO_PUBLIC_IAP_FUNCTIONS_BASE_URL": "https://us-central1-advent-calendar-12.cloudfunctions.net"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
