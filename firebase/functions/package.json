{
  "name": "iap-functions",
  "version": "1.0.0",
  "description": "Firebase HTTPS functions for validating in-app purchase receipts",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions",
    "lint": "eslint . --ext .ts"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "jsonwebtoken": "^9.0.3"
  },
  "overrides": {
    "jws": "^4.0.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "typescript": "^5.4.5"
  }
}
