{
  "name": "iap-functions",
  "version": "1.0.0",
  "description": "Firebase HTTPS functions for validating in-app purchase receipts",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && npx firebase-tools emulators:start --only functions",
    "deploy": "npm run build && npx firebase-tools deploy --only functions",
    "lint": "eslint ."
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "jsonwebtoken": "^9.0.3"
  },
  "overrides": {
    "jws": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.1"
  }
}
