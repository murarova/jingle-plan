{
  "expo": {
    "name": "Jingle Plan",
    "slug": "jingle-plan",
    "version": "1.7.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.murarova.adventCalendar",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSUserTrackingUsageDescription": "Ми використовуємо ваш ідентифікатор лише для показу персоналізованої реклами."
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.murarova.jingleplan",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos."
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "./plugins/with-firebase-configure.js",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth",
              "RNFBDatabase",
              "RNFBMessaging",
              "RNFBStorage"
            ]
          },
          "android": {
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class io.invertase.notifee.** { *; }\n-keep class app.notifee.** { *; }\n-dontwarn app.notifee.**\n-dontwarn io.invertase.notifee.**\n-keep class * extends androidx.room.RoomDatabase { *; }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class androidx.work.impl.** { *; }\n-keep class androidx.startup.** { *; }",
            "extraMavenRepos": [
              "../../node_modules/@notifee/react-native/android/libs"
            ]
          }
        }
      ],
      "expo-localization",
      "expo-iap",
      [
        "react-native-fbsdk-next",
        {
          "appID": "819298757617808",
          "clientToken": "0bc7ea62ce2e99a4e23477bf9ce9eea8",
          "displayName": "JinglePlan",
          "scheme": "fb819298757617808",
          "advertiserIDCollectionEnabled": false,
          "autoLogAppEventsEnabled": false,
          "isAutoInitEnabled": true,
          "iosUserTrackingPermission": "This identifier will be used to deliver personalized ads to you."
        }
      ],
      "expo-tracking-transparency",
      "expo-font",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splashscreen.png",
          "resizeMode": "cover",
          "backgroundColor": "#f4f0e6",
          "ios": {
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "image": "./assets/icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1d31307a-c023-4cc8-8430-048d3f9e5f07"
      }
    }
  }
}
